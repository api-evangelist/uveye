      "id": "788a92df-f041-492f-a9c4-583e5029e119",
      "name": "Merchandise",
      "description": {
        "content": "Submit dealer inventory for merchandising and mark vehicles sold.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a61c7ab6-cf48-411e-8229-75ad142e8085",
          "name": "Submit inventory",
          "request": {
            "name": "Submit inventory",
            "description": {
              "content": "Push VINs plus basic vehicle data; UVeye scans, renders multi-angle images and pushes them back to your webhook. Batch limit is 100 vehicles per request (more returns 413). Resubmit your full active inventory periodically (for example every 4 hours) - unchanged vehicles are no-ops, deduplicated by content hash. Processed asynchronously: there is no per-VIN validation in the response, and a malformed or incomplete VIN is excluded and simply never produces a webhook.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "merchandise",
                "inventory",
                "vehicles"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicles\": [\n    {\n      \"vin\": \"<string>\",\n      \"make\": \"<string>\",\n      \"model\": \"<string>\",\n      \"year\": \"<integer>\",\n      \"color\": \"<string>\",\n      \"body\": \"<string>\",\n      \"stockNumber\": \"<string>\",\n      \"trim\": \"<string>\",\n      \"mileage\": \"<integer>\",\n      \"type\": \"<string>\",\n      \"sellingPrice\": \"<number>\",\n      \"interiorColor\": \"<string>\",\n      \"transmission\": \"<string>\",\n      \"drivetrain\": \"<string>\",\n      \"engine\": \"<string>\",\n      \"fuelType\": \"<string>\",\n      \"msrp\": \"<number>\",\n      \"certified\": \"<boolean>\",\n      \"photoCount\": \"<integer>\",\n      \"stockInDate\": \"<string>\"\n    },\n    {\n      \"vin\": \"<string>\",\n      \"make\": \"<string>\",\n      \"model\": \"<string>\",\n      \"year\": \"<integer>\",\n      \"color\": \"<string>\",\n      \"body\": \"<string>\",\n      \"stockNumber\": \"<string>\",\n      \"trim\": \"<string>\",\n      \"mileage\": \"<integer>\",\n      \"type\": \"<string>\",\n      \"sellingPrice\": \"<number>\",\n      \"interiorColor\": \"<string>\",\n      \"transmission\": \"<string>\",\n      \"drivetrain\": \"<string>\",\n      \"engine\": \"<string>\",\n      \"fuelType\": \"<string>\",\n      \"msrp\": \"<number>\",\n      \"certified\": \"<boolean>\",\n      \"photoCount\": \"<integer>\",\n      \"stockInDate\": \"<string>\"\n    }\n  ]\n}",
