          "id": "427d688e-2088-4e55-beaf-0ecdfbaf9170",
          "name": "Record that an inspection was shared",
          "request": {
            "name": "Record that an inspection was shared",
            "description": {
              "content": "Records that an inspection's public link was shared with a customer. Call this after sending a public link so the share is logged in the UVeye system. Returns 200 with an empty body on success.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "inspection-shared"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
